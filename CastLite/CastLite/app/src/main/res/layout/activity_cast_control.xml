<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/controlRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/controlToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/control_screen_title" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="16dp"
            android:paddingEnd="18dp"
            android:paddingBottom="24dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="22dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:id="@+id/controlStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:accessibilityLiveRegion="polite"
                        android:gravity="center"
                        android:text="@string/control_waiting"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/controlTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:maxLines="2"
                        android:text="@string/control_media_unknown"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/controlDevice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:text="@string/control_device_unknown"
                        android:textSize="14sp" />

                    <ProgressBar
                        android:id="@+id/controlBuffering"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:layout_marginTop="14dp"
                        android:indeterminate="true"
                        android:visibility="gone" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/currentTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="46dp"
                            android:text="00:00"
                            android:textSize="12sp" />

                        <SeekBar
                            android:id="@+id/mediaSeekBar"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:contentDescription="@string/control_seek_description"
                            android:enabled="false"
                            android:max="1000" />

                        <TextView
                            android:id="@+id/totalTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:minWidth="46dp"
                            android:text="00:00"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/controlSeekBack"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="68dp"
                            android:layout_height="54dp"
                            android:layout_marginEnd="6dp"
                            android:contentDescription="@string/control_back_10_description"
                            android:enabled="false"
                            android:minWidth="0dp"
                            android:text="@string/control_back_10"
                            android:textAllCaps="false"
                            android:textSize="13sp"
                            app:cornerRadius="18dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/controlPlayPause"
                            android:layout_width="0dp"
                            android:layout_height="58dp"
                            android:layout_weight="1"
                            android:enabled="false"
                            android:text="@string/play"
                            android:textAllCaps="false"
                            android:textSize="16sp"
                            app:cornerRadius="20dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/controlSeekForward"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="68dp"
                            android:layout_height="54dp"
                            android:layout_marginStart="6dp"
                            android:contentDescription="@string/control_forward_10_description"
                            android:enabled="false"
                            android:minWidth="0dp"
                            android:text="@string/control_forward_10"
                            android:textAllCaps="false"
                            android:textSize="13sp"
                            app:cornerRadius="18dp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/controlStop"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:enabled="false"
                        android:text="@string/stop"
                        android:textAllCaps="false"
                        app:cornerRadius="16dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="@string/control_remote_heading"
                android:textSize="20sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardCornerRadius="28dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingTop="20dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/controlVolumeDown"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="54dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:contentDescription="@string/control_volume_down"
                            android:enabled="false"
                            android:text="−"
                            android:textSize="24sp"
                            app:cornerRadius="18dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/controlMute"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="54dp"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1.3"
                            android:contentDescription="@string/control_mute"
                            android:enabled="false"
                            android:text="@string/remote_mute_label"
                            android:textSize="13sp"
                            app:cornerRadius="18dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/controlVolumeUp"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="54dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:contentDescription="@string/control_volume_up"
                            android:enabled="false"
                            android:text="+"
                            android:textSize="24sp"
                            app:cornerRadius="18dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center"
                        android:orientation="horizontal">
                        <Space
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/remoteUp"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="68dp"
                            android:layout_height="56dp"
                            android:contentDescription="@string/control_up"
                            android:enabled="false"
                            android:text="▲"
                            android:textSize="20sp"
                            app:cornerRadius="20dp" />
                        <Space
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/remoteLeft"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="68dp"
                            android:layout_height="56dp"
                            android:contentDescription="@string/control_left"
                            android:enabled="false"
                            android:text="◀"
                            android:textSize="20sp"
                            app:cornerRadius="20dp" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/remoteSelect"
                            android:layout_width="76dp"
                            android:layout_height="64dp"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="8dp"
                            android:enabled="false"
                            android:text="@string/remote_select_label"
                            android:textSize="16sp"
                            app:cornerRadius="32dp" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/remoteRight"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="68dp"
                            android:layout_height="56dp"
                            android:contentDescription="@string/control_right"
                            android:enabled="false"
                            android:text="▶"
                            android:textSize="20sp"
                            app:cornerRadius="20dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal">
                        <Space
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/remoteDown"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="68dp"
                            android:layout_height="56dp"
                            android:contentDescription="@string/control_down"
                            android:enabled="false"
                            android:text="▼"
                            android:textSize="20sp"
                            app:cornerRadius="20dp" />
                        <Space
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:orientation="horizontal">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/remoteHome"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:contentDescription="@string/control_home"
                            android:enabled="false"
                            android:text="@string/remote_home_label"
                            android:textSize="11sp"
                            app:cornerRadius="14dp" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/remoteBack"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:contentDescription="@string/control_back_key"
                            android:enabled="false"
                            android:text="@string/remote_back_label"
                            android:textSize="11sp"
                            app:cornerRadius="14dp" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/remoteInfo"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:contentDescription="@string/control_info"
                            android:enabled="false"
                            android:text="@string/remote_info_label"
                            android:textSize="11sp"
                            app:cornerRadius="14dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/remoteCapabilityHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:text="@string/remote_capabilities_limited"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/controlHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="@string/control_hint"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/backToBrowser"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/control_back_to_browser"
                android:textAllCaps="false" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
